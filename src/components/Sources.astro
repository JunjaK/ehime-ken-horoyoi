---
import type { SourceRef } from '../data/types.ts';
interface Props { sources: SourceRef[]; id: string }
const { sources, id } = Astro.props;
const labels: Record<SourceRef['type'], string> = {
  'brewery-official': '제조사 공식', 'ehime-sake-association': '사케 조합',
  government: '정부', 'official-tourism': '공식 관광', retailer: '판매처', other: '기타',
};
---
<details class="mt-3 border-t border-border pt-3 text-xs text-muted-foreground">
  <summary data-testid={`guide-sources-toggle-${id}`} class="w-fit cursor-pointer rounded-md border border-border px-3 py-2 focus-visible:outline-2">출처 · {sources.length}</summary>
  <ul class="mt-3 space-y-3 break-words">
    {sources.map((source, index) => <li>
      <a data-testid={`guide-source-open-${id}-${index}`} href={source.url} target="_blank" rel="noreferrer" class="underline underline-offset-4 hover:text-foreground">{source.title}</a>
      <span class="mt-1 block">{labels[source.type]} · 확인 {source.accessedAt}</span>
    </li>)}
  </ul>
</details>
