---
import type { Product } from '../data/types.ts';
import Sources from './Sources.astro';
interface Props { product: Product; brandName: string; related: boolean }
const { product: p, brandName, related } = Astro.props;
const percent = (value: number | string | null) => typeof value === 'number' ? `${value}%` : value === null ? null : value.includes('%') ? value : `${value}%`;
const specs = [
  { label: '도수', value: percent(p.alcohol) },
  ...(p.kind === 'sake' ? [
    { label: '정미율', value: percent(p.polishingRatio) },
    { label: '주미', value: p.rice?.join(' · ') },
    { label: '일본주도', value: typeof p.nihonshudo === 'number' && p.nihonshudo > 0 ? `+${p.nihonshudo}` : p.nihonshudo },
    { label: '산도', value: p.acidity },
    { label: '아미노산도', value: p.aminoAcidity },
    { label: '효모', value: p.yeast },
  ] : [
    { label: '원료', value: p.ingredients.join(' · ') },
    { label: '증류', value: p.distillation },
  ]),
].filter((spec) => spec.value !== null && spec.value !== undefined);
---
<section class="min-w-0 rounded-xl border border-border bg-card p-4" data-product-id={p.id} data-testid={`guide-product-card-${p.id}`}>
  {related && <p class="mb-2 text-xs text-match-2">같은 양조장의 다른 브랜드 · {brandName}</p>}
  <p class="text-xs text-muted-foreground">{p.nameKo}</p>
  <h4 class="mt-1 break-words text-base font-semibold" lang="ja">{p.nameJa}</h4>
  {p.nameKana && <p class="mt-1 text-xs text-muted-foreground" lang="ja">{p.nameKana}</p>}
  <div class="mt-3 flex flex-wrap gap-1.5 text-[11px]">
    <span class="rounded border border-border px-2 py-1">{p.kind === 'shochu' ? '증류주 · ' : ''}{p.category}</span>
    {p.kind === 'sake' && p.attributes.map((attribute) => <span class="rounded border border-border px-2 py-1" lang="ja">{attribute}</span>)}
    {p.availability !== '不明' && <span class="rounded border border-border px-2 py-1">{{ 定番: '정규 제품', 季節限定: '계절 한정', 数量限定: '수량 한정' }[p.availability]}</span>}
  </div>
  <p class="mt-3 text-xs leading-relaxed text-muted-foreground">{p.descriptionKo}</p>
  {specs.length > 0 && <dl class="mt-4 grid grid-cols-[5rem_1fr] gap-x-3 gap-y-2 text-xs">
    {specs.map((spec) => <><dt class="text-muted-foreground">{spec.label}</dt><dd class="break-words tabular-nums">{spec.value}</dd></>)}
  </dl>}
  <p class="mt-4 text-[11px] leading-relaxed text-muted-foreground">사양 자료 {p.specAsOf}{p.batch && ` · ${p.batch}`}<br />2026 페스타 제공 {p.festivalOffering === 'unknown' ? '미확인' : '공식 확인'} · 현재 재고 미확인</p>
  {p.notes.map((note) => <p class="mt-2 text-xs leading-relaxed text-match-2">{note}</p>)}
  <Sources sources={p.sources} id={p.id} />
</section>
