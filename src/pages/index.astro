---
import { BREWERIES, MATCH_LABEL, REGION_FILTERS, REGION_LABEL_KO, tasteBars } from '../data/breweries.ts';
import '../styles/global.css';

// 클래스명을 문자열 그대로 적어야 Tailwind 스캐너가 잡는다. 문자열 조합 금지.
const DOT_BG: Record<number, string> = { 1: 'bg-match-1', 2: 'bg-match-2', 3: 'bg-match-3' };
const BADGE: Record<number, string> = {
  1: 'border-match-1/40 text-match-1',
  2: 'border-match-2/40 text-match-2',
  3: 'border-match-3/40 text-match-3',
};
const BAR_BG: Record<number, string> = { 1: 'bg-match-1', 2: 'bg-match-2', 3: 'bg-match-3' };

const EYEBROW = 'font-mono text-[10px] tracking-[0.14em] text-muted-foreground uppercase';
const CARD = 'rounded-xl border border-border bg-card';
const SPEC_KEY = 'text-muted-foreground';
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>에히메현 양조장 지도 · 호로요이 페스타 2026</title>
    <meta
      name="description"
      content="호로요이 페스타 2026(2026.10.02 마쓰야마 조자야마 공원) 참가 19개 브랜드의 위치, 맛 프로필, 우선 시도할 술과 부스에서 쓸 일본어 문장."
    />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-jp-dynamic-subset.min.css"
    />
  </head>

  <body class="flex min-h-screen flex-col">
    <header class="flex flex-wrap items-end gap-x-8 gap-y-4 border-b border-border px-6 py-6">
      <div class="flex-1 basis-80">
        <p class={EYEBROW}>ほろよいフェスタ 2026 · 2026.10.02 松山城山公園</p>
        <h1 class="mt-2 text-3xl font-semibold tracking-tight">에히메현 양조장 지도</h1>
        <p class="mt-2 max-w-[52ch] text-sm leading-relaxed text-pretty text-muted-foreground">
          호로요이 페스타 2026 참가 19개 브랜드. 지도의 점 위에 마우스를 올리거나(모바일은 탭) 왼쪽 목록을 누르면
          양조장 정보가 나옵니다.
        </p>
      </div>

      <div class="flex flex-col gap-2">
        <label for="region" class="text-xs font-medium text-muted-foreground">지역</label>
        <select
          id="region"
          class="h-9 min-w-54 appearance-none rounded-md border border-input bg-transparent bg-[url('data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%2210%22 height=%226%22><path d=%22M0 0l5 6 5-6z%22 fill=%22%23a1a1a1%22/></svg>')] bg-[length:10px_6px] bg-[position:right_0.75rem_center] bg-no-repeat py-1 pr-8 pl-3 text-sm shadow-xs transition-colors hover:bg-accent focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none"
        >
          {REGION_FILTERS.map((option) => <option value={option.value}>{option.label}</option>)}
        </select>
      </div>
    </header>

    <section class={`mx-6 mt-4 p-5 ${CARD}`}>
      <div class="flex flex-wrap items-baseline gap-3 border-b border-border pb-3.5">
        <span class={EYEBROW}>행사 정보</span>
        <span class="text-base font-semibold tracking-tight">호로요이 페스타 2026</span>
      </div>

      <dl class="mt-4 grid gap-x-8 gap-y-4 text-sm sm:grid-cols-2">
        <div>
          <dt class={SPEC_KEY}>일시</dt>
          <dd class="mt-1">10월 2일(금) · 접수 18:00 · 건배 19:00</dd>
        </div>
        <div>
          <dt class={SPEC_KEY}>장소</dt>
          <dd class="mt-1">마쓰야마시 호리노우치 조자야마 공원 관리광장</dd>
        </div>
        <div>
          <dt class={SPEC_KEY}>회비</dt>
          <dd class="mt-1">사전 5,500엔 / 현장 6,500엔 · 20~30세 3,500엔 / 4,500엔 (식사권 1,000엔 포함)</dd>
        </div>
        <div>
          <dt class={SPEC_KEY}>주의</dt>
          <dd class="mt-1 text-muted-foreground">
            정원제 · 우천 취소. 취소 여부는 9/30 12시 에히메현 사케조합 홈페이지 공지. 20~30세 할인은 신분증 필요.
          </dd>
        </div>
      </dl>
    </section>

    <main class="flex min-h-0 flex-1 flex-wrap items-stretch">
      <aside class="flex max-h-[min(72vh,520px)] min-w-70 flex-[0_1_20rem] flex-col border-b border-border md:border-r md:border-b-0">
        <div class="flex items-baseline justify-between border-b border-border px-4 py-3">
          <h2 class="text-sm font-semibold tracking-tight">참가 브랜드</h2>
          <span class="font-mono text-xs tabular-nums text-muted-foreground">
            <span id="count">{BREWERIES.length}</span> / {BREWERIES.length}
          </span>
        </div>

        <div id="list" class="overflow-y-auto p-2">
          {
            BREWERIES.map((b) => (
              <button
                type="button"
                data-id={b.id}
                data-region={b.region}
                class="group flex w-full items-center gap-3 rounded-md px-2.5 py-2 text-left transition-colors hover:bg-accent focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none aria-[current=true]:bg-accent"
              >
                <span
                  class={`flex size-7 shrink-0 items-center justify-center rounded-full text-xs font-semibold tabular-nums text-background transition-colors group-aria-[current=true]:bg-foreground ${DOT_BG[b.match]}`}
                >
                  {b.id}
                </span>
                <span class="min-w-0">
                  <span class="flex flex-wrap items-baseline gap-x-2">
                    <span class="text-sm font-medium tracking-tight">{b.ko}</span>
                    <span class="text-xs text-muted-foreground" lang="ja">
                      {b.ja}
                    </span>
                  </span>
                  <span class="mt-0.5 block truncate text-xs text-muted-foreground">
                    {b.brewery} · {b.city}
                  </span>
                </span>
              </button>
            ))
          }
        </div>
      </aside>

      <div class="relative m-3 min-h-115 min-w-75 flex-[1_1_28rem] overflow-hidden rounded-xl border border-border">
        <div id="map" class="absolute inset-0"></div>

        <div
          class="absolute bottom-3 left-3 z-500 flex flex-col gap-1.5 rounded-lg border border-border bg-card/90 px-3 py-2.5 text-xs text-muted-foreground backdrop-blur-sm"
        >
          <div class="flex items-center gap-2"><span class="size-2.5 rounded-full bg-match-1"></span>취향 최우선</div>
          <div class="flex items-center gap-2"><span class="size-2.5 rounded-full bg-match-2"></span>다음 우선순위</div>
          <div class="flex items-center gap-2"><span class="size-2.5 rounded-full bg-match-3"></span>후순위 · 소주</div>
        </div>
      </div>
    </main>

    <section id="details" class="border-t border-border">
      {
        BREWERIES.map((b) => (
          <article class="flex max-w-[1500px] flex-wrap items-start gap-x-12 gap-y-6 px-6 py-7" data-id={b.id} hidden>
            <div class="flex-1 basis-85 space-y-0">
              <div class="flex items-center gap-2.5">
                <span
                  class={`flex size-8 shrink-0 items-center justify-center rounded-full text-sm font-semibold tabular-nums text-background ${DOT_BG[b.match]}`}
                >
                  {b.id}
                </span>
                <span class={`inline-flex items-center rounded-md border px-2 py-0.5 text-xs font-medium ${BADGE[b.match]}`}>
                  {MATCH_LABEL[b.match]}
                </span>
              </div>

              <h2 class="mt-3 text-2xl font-semibold tracking-tight">{b.ko}</h2>
              <div class="mt-0.5 text-sm text-muted-foreground" lang="ja">
                {b.ja}
              </div>
              <p class="mt-3.5 text-sm leading-relaxed text-pretty text-muted-foreground">{b.style}</p>

              <div class="mt-5 space-y-2.5 border-t border-border pt-4">
                <div class={EYEBROW}>맛 프로필</div>
                {tasteBars(b).map((bar) => (
                  <div class="grid grid-cols-[3.5rem_1fr_2rem] items-center gap-2.5">
                    <span class="text-xs text-muted-foreground">{bar.label}</span>
                    <span class="h-1.5 overflow-hidden rounded-full bg-muted">
                      <span class={`block h-full rounded-full ${BAR_BG[b.match]}`} style={`width:${bar.value * 20}%`} />
                    </span>
                    <span class="text-right font-mono text-[10.5px] tabular-nums text-muted-foreground">
                      {bar.value}/5
                    </span>
                  </div>
                ))}
              </div>
            </div>

            <div class="flex-1 basis-85">
              <dl class="grid grid-cols-[4.5rem_1fr] gap-x-3 gap-y-2.5 text-sm">
                <dt class={SPEC_KEY}>양조장</dt>
                <dd>{b.brewery}</dd>
                <dt class={SPEC_KEY}>창업</dt>
                <dd>{b.founded}</dd>
                <dt class={SPEC_KEY}>주소</dt>
                <dd class="font-mono text-xs leading-relaxed" lang="ja">
                  {b.addr}
                </dd>
                <dt class={SPEC_KEY}>지역</dt>
                <dd>{REGION_LABEL_KO[b.region]}</dd>
                <dt class={SPEC_KEY}>물·쌀</dt>
                <dd>{b.water}</dd>
                <dt class={SPEC_KEY}>페어링</dt>
                <dd>{b.pair}</dd>
                <dt class={SPEC_KEY}>온도</dt>
                <dd>{b.temp}</dd>
                <dt class={SPEC_KEY}>시음 순서</dt>
                <dd>{b.step}</dd>
              </dl>

              <div class="mt-4 rounded-lg border border-border bg-muted/40 px-4 py-3.5">
                <div class={EYEBROW}>우선 시도</div>
                <div class="mt-1.5 text-sm leading-relaxed">{b.pick}</div>
              </div>

              <div class="mt-3 rounded-lg border border-dashed border-border px-4 py-3.5">
                <div class={EYEBROW}>부스에서 물어볼 말</div>
                <div class="mt-1.5 text-sm leading-relaxed" lang="ja">
                  {b.jp}
                </div>
                <div class="mt-1.5 text-xs leading-relaxed text-muted-foreground">{b.jpKo}</div>
              </div>
            </div>
          </article>
        ))
      }

      <div
        id="empty"
        class="grid max-w-[1500px] grid-cols-[repeat(auto-fit,minmax(18rem,1fr))] items-start gap-x-11 gap-y-6 px-6 py-8 text-sm leading-relaxed text-muted-foreground"
      >
        <div>
          <div class="mb-2 text-base font-semibold tracking-tight text-foreground">양조장을 골라 보세요</div>
          지도의 번호를 올리거나 탭하면 여기에 브랜드 스타일, 맛 프로필, 주소, 우선 시도할 술, 부스에서 쓸 일본어 문장이
          표시됩니다.
        </div>

        <div>
          <div class="mb-1.5 font-medium text-foreground">부스에서 쓸 공통 한 문장</div>
          <div class="text-sm leading-relaxed text-foreground" lang="ja">
            芳醇甘口で、酸味があって、できれば生酒か無濾過生原酒が好きです。吟醸系でおすすめはありますか？
          </div>
          <div class="mt-1.5 text-xs leading-relaxed">
            “호우쥰아마구치에 산미가 있고, 가능하면 생주나 무여과 생원주를 좋아합니다. 긴죠 계열 추천이 있나요?”
          </div>
        </div>

        <div class="border-t border-border pt-4">
          <div class="mb-2.5 font-medium text-foreground">취향 기준 시음 흐름</div>
          <ol class="flex flex-col gap-2 text-xs">
            <li class="grid grid-cols-[1.125rem_1fr] gap-2">
              <span class="font-mono text-match-1">①</span><span>스타트 — 스키고코로 니코마루 생주, 카신</span>
            </li>
            <li class="grid grid-cols-[1.125rem_1fr] gap-2">
              <span class="font-mono text-match-1">②</span><span>하나히메자쿠라 아라바시리 생원주</span>
            </li>
            <li class="grid grid-cols-[1.125rem_1fr] gap-2">
              <span class="font-mono text-match-1">③</span><span>이요카기야 무여과 생원주</span>
            </li>
            <li class="grid grid-cols-[1.125rem_1fr] gap-2">
              <span class="font-mono text-match-1">④</span><span>야마토고코로 찹쌀 4단 생원주</span>
            </li>
            <li class="grid grid-cols-[1.125rem_1fr] gap-2">
              <span class="font-mono text-match-2">⑤</span><span>유키스즈메·니키타츠·쿄히나 사쿠라히메 효모 비교</span>
            </li>
            <li class="grid grid-cols-[1.125rem_1fr] gap-2">
              <span class="font-mono text-match-2">⑥</span><span>이시즈치·치요노카메 고급 긴죠로 균형 확인</span>
            </li>
            <li class="grid grid-cols-[1.125rem_1fr] gap-2">
              <span class="font-mono text-match-3">⑦</span><span>음식과 함께 야마탄마사무네·카제노사토 식중주</span>
            </li>
            <li class="grid grid-cols-[1.125rem_1fr] gap-2">
              <span class="font-mono text-match-3">⑧</span><span>마무리 — 히메바야시 밤 소주</span>
            </li>
          </ol>
        </div>

        <div class="border-t border-border pt-4 text-xs leading-relaxed">
          에히메는 400년 이상의 사케 산지로, 현재 약 35~37곳의 양조장이 있습니다. 이시즈치산 등 시코쿠 산맥의 연수~중경수를
          써서 온화하고 섬세한 ‘이요(伊予)의 여성적인 술’로 불려 왔고, 세토내해·우와카이의 흰살생선과 특히 잘 맞습니다.
        </div>
      </div>
    </section>

    <script>
      import '../scripts/map.ts';
    </script>
  </body>
</html>
